{
  "framework": "vite",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://321go-backend.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api$|api/).*)",
      "destination": "/index.html"
    }
  ]
}